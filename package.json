{
  "name": "faro",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:stats": "ng build --stats-json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:faro": "node dist/faro/server/server.mjs",
    "lint": "ng lint",
    "e2e": "playwright test",
    "check:tokens": "node scripts/ui-checks/tokens.mjs",
    "check:stack": "node scripts/ui-checks/removed-stack.mjs",
    "check:bundle": "node scripts/ui-checks/public-bundle.mjs",
    "check:boundary": "node scripts/ui-checks/boundary.mjs",
    "check:headers": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/security/check-headers.mjs",
    "check:secrets": "node scripts/security/check-secrets.mjs",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "check:templates": "node scripts/security/check-templates.mjs",
    "check:prod-config": "node scripts/security/check-prod-config.mjs",
    "test:scripts": "node --test \"scripts/security/*.test.mjs\"",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "check:ui": "npm run check:tokens && npm run check:stack && npm run check:boundary"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-server": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@angular/ssr": "^21.2.30",
    "@boxicons/js": "^1.0.1",
    "@ng-icons/core": "^34.0.0",
    "@supabase/supabase-js": "^2.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "leaflet": "1.9.4",
    "ngx-sonner": "^3.1.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/localize": "^21.2.26",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/express": "^5.0.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
