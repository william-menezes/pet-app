# supabase/.env.local.example
# Template de variáveis de ambiente locais — NÃO contém segredos reais.
# Copie para supabase/.env.local e preencha com os valores locais.
# O arquivo .env.local está no .gitignore; NUNCA commite o .env.local real.

# Segredos das Edge Functions (usados por `supabase functions serve`)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id-here
GOOGLE_OAUTH_SECRET=your-google-client-secret-here

# Salt para hash de e-mail/IP em auth_login_attempts e auth_audit_log.
# Em produção: use `supabase secrets set HASH_SALT=<valor-aleatorio-forte>`
HASH_SALT=local-dev-salt-replace-in-production

# Chave do serviço (gerada automaticamente pelo `supabase start`; NÃO commitar).
# Disponível em: supabase status -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# URL local do Supabase (gerada pelo `supabase start`)
SUPABASE_URL=http://localhost:54321

# --- Spec 004-conta-tutor (valores de exemplo do quickstart; nenhum segredo real) ---

# Chave publica (anon) do "supabase status"; usada pelas Edge Functions para checar senha.
SUPABASE_ANON_KEY=
# Chave dos codigos SMS (HMAC). 32+ caracteres. Em producao: supabase secrets set.
PHONE_OTP_PEPPER=local-dev-pepper-0123456789-abcdefghij
# Ambiente: local | test | staging | production (ausente = production).
FARO_ENV=local
# Driver de SMS: log (mostra no log da funcao) | stub (codigo fixo, so local/test) | driver real.
SMS_DRIVER=log
# Codigo fixo de 6 digitos; so e lido com SMS_DRIVER=stub e FARO_ENV local/test.
SMS_STUB_CODE=424242
# Teto global de SMS em 24 h.
SMS_DAILY_CAP=500
# Origens aceitas no CORS das funcoes (lista separada por virgula). Producao: https://tagfaro.com.br
ALLOWED_ORIGINS=http://localhost:4200
# URL publica do app (usada em links). Producao: https://tagfaro.com.br
SITE_URL=http://localhost:4200
